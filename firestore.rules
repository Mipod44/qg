rules_version = '2';
// Règles de sécurité du QG ASM Basket.
// - Toute personne connectée peut demander l'accès (fiche "members" en attente).
// - Seuls les membres validés (staff ou admin) lisent et modifient les données du club.
// - Seuls les admins valident ou retirent des membres.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function superAdmin() {
      return signedIn() && request.auth.token.email == "mahemaxime22@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function role() { return get(memberDoc()).data.role; }
    function isStaff() { return superAdmin() || (signedIn() && exists(memberDoc()) && role() in ['staff', 'admin']); }
    function isAdmin() { return superAdmin() || (signedIn() && exists(memberDoc()) && role() == 'admin'); }

    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'pending');
      allow update, delete: if isAdmin();
    }

    match /{coll}/{id} {
      allow read, write: if isStaff() && coll in ['conv', 'matches', 'msgs', 'events', 'tasks', 'meta'];
    }
  }
}
